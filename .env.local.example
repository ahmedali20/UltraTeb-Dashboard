# ============================
# Supabase
# ============================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================
# Dashboard session & bootstrap admin
# ============================
# سلسلة عشوائية قوية (32+ حرف) بتستخدم لتوقيع الـ session cookie.
# ولّدها مرة واحدة وحطها هنا وفي Vercel، وماتغيرهاش بعد كده غير لو عايز
# تلغي كل الـ sessions الحالية.
# تقدر تولّدها بالأمر: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string

# أول مرة تسجل دخول بالـ username/password دول، هيتعمل تلقائيًا
# حساب admin بنفس البيانات في جدول dashboard_users. بعد كده تقدر
# تدير باقي المستخدمين من صفحة /users.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-strong-password

# ============================
# Cron (Google Sheets sync)
# ============================
# سر بيتحقق منه الـ middleware عشان يسمح لـ Vercel Cron إنه يشغل
# /api/google-sheets-sync من غير ما يعدي بتسجيل الدخول.
CRON_SECRET=change-me-random-cron-secret

# بيانات Google Service Account (من Google Cloud Console) اللي بتستخدم
# لقراءة الشيت المحدد داخل app/api/google-sheets-sync/route.ts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
